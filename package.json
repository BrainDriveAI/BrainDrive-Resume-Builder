{
  "name": "@braindrive/resume-builder",
  "version": "4.3.1",
  "private": true,
  "type": "module",
  "description": "Resume Builder standalone package, app-owned workflow, inference program, resources, tests, and local-dev release artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrainDriveAI/BrainDrive-Resume-Builder.git"
  },
  "scripts": {
    "validate": "node scripts/validate-package-contract.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "node scripts/generate-local-dev-package.mjs",
    "verify:ws5": "node scripts/verify-with-ws5.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "braindrive": {
    "appId": "ai.braindrive.resume-builder",
    "appContractSchemaVersion": 1,
    "resumeDataSchemaVersion": 3,
    "resumeInferenceSchemaVersion": 1,
    "appBridgeSchemaVersion": 1,
    "runtimeEnabled": true
  }
}
